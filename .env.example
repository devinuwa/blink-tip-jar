# Cluster switch. Use mainnet-beta for mainnet.
SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Public RPC. Override with a dedicated endpoint if the public one rate-limits.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Recipient of every tip, unless the action URL passes a valid ?to=<pubkey>.
CREATOR_WALLET=Ffr7zj2fw9h1LSMwUCSJBSmKhztHJprZ3Sw2GS5KNxS6

# Devnet default in code is Circle USDC (4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU).
# Mainnet default in code is Circle USDC (EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v).
# Set this to force a mint on any cluster.
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Local demo payer only. JSON array of the 64 secret key bytes. Never commit .env.
TIP_PAYER_SECRET=
